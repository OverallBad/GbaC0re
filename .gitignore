# mGBA source (fetched at build time, not shipped)
ps5/mgba/
mgba/

# Build artifacts
*.o
*.a
*.so
*.elf
*.bin
*.exe
*.dll
__pycache__/
*.pyc
*.pyo

# Generated Lua loader (built from lua/gba.lua.in by build.py)
ps5/lua/gba.lua

# Build directories
build/
dist/
*.zip

# Editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# ROMs, saves, and states (never commit - copyrighted/personal)
*.gba
*.gb
*.gbc
*.sav
*.ss0
saves/
states/
# Allow the empty ps5/roms/ folder (with README) but ignore its contents
roms/*
!ps5/roms/
ps5/roms/*
!ps5/roms/README.txt

# Logs
*.log
ps5log.txt

# Local config
*.local
.env
